# --- Database (required) ---
# A Postgres connection string. Works with Vercel Postgres, Neon, Supabase,
# or a local Postgres on your Mac Mini.
#
# Vercel: when you add a Postgres store to the project, it sets POSTGRES_URL
# for you automatically — you don't need to copy anything.
# Local / Mac Mini example:
#   DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/arka_tracker
DATABASE_URL=

# --- Access (optional) ---
# Leave BLANK for the public portfolio demo (anyone can open and edit the
# demo data). Set a password to lock the app down for real Arka data — you'll
# be asked for it once and remembered on that device.
APP_PASSWORD=

# Your name, shown in the greeting. Optional.
NEXT_PUBLIC_USER_NAME=Saketh
