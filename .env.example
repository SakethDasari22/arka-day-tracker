# --- Database (required) ---
# A Postgres connection string. Works with Vercel Postgres, Neon, Supabase,
# or a local Postgres on your Mac Mini.
#
# Vercel: when you add a Postgres store to the project, it sets POSTGRES_URL
# for you automatically — you don't need to copy anything.
# Local / Mac Mini example:
#   DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/arka_tracker
DATABASE_URL=

# --- Access (optional) ---
# Leave BLANK for the public portfolio demo (anyone can open and edit the
# demo data). Set a password to lock the app down for real Arka data — you'll
# be asked for it once and remembered on that device.
APP_PASSWORD=

# Your name, shown in the greeting. Optional.
NEXT_PUBLIC_USER_NAME=Saketh

# --- Google (Gmail + Sheets + Drive) ---
# Create an OAuth client in Google Cloud Console (see README), then paste the
# client id and secret here. Leave blank to keep the Google features turned off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if auto-detection of your site URL is wrong (e.g. a custom domain).
# Must match the redirect URI you registered, without the /api/google/callback part.
APP_BASE_URL=

# --- AI task summaries (optional) ---
# If set, emails are summarized into tasks with Claude. Without it, a simple
# rule-based parser is used instead (still works, just less polished).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
